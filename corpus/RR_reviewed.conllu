# sent_id = S000077
# speaker = Varro
# edition_loc = 1.2.10
# text_old = Huiusce, inquam, pomarii summa sacra via, ubi poma veneunt contra aurum, imago.
# text = huiusce – inquam – pomarii summa sacra via, ubi poma veneunt contra aurum, imago.
# text_en = Of this man's orchard, I say, the upper Sacred Way - where fruits sell for their weight in gold - is an image.
# text_fr = De ce verger, dis-je, la haute voie Sacrée, où les fruits se vendent à prix d'or, est une image.
# text_fi = Tämän miehen hedelmätarhasta, sanon, Pyhän tien yläosa, jossa hedelmiä myydään kullan hinnasta, on kuva.
# review_status = silver
