# sent_id = S000151
# speaker = Scrofa
# edition_loc = 1.4.4
# text_old = Etenim si propter terram aut aquam odore, quem aliquo loco eructat, pestilentior est fundus, aut propter caeli regionem ager calidior sit, aut ventus non bonus flet, haec vitia emendari solent domini scientia ac sumptu, quod permagni interest, ube sint positae villae, quantae sint, quo spectent porticibus, ostiis ac fenestris.
# text = etenim si propter terram aut aquam odore, quem aliquo loco eructat, pestilentior est fundus, aut propter caeli regionem ager calidior sit, aut ventus non bonus flet, haec vitia emendari solent domini scientia ac sumptu, quod permagni interest, ube sint positae villae, quantae sint, quo spectent porticibus, ostiis ac fenestris.
# text_en = For if, on account of a smell near the land or water, which it belches out in some place, the estate is more pestilential, or on account of the region of the sky the land becomes hotter, or a wind that is not good blows, these defects are usually corrected by the owner’s expertise and expense, because it matters a great deal where the villas have been sited, how large they are, and which way their porticoes, doors and windows face.
# text_fr = Car si, à cause d’une odeur près de la terre ou de l’eau, qu’elle exhale en quelque endroit, le domaine devient plus pestilentiel, ou si à cause de la région du ciel le terrain devient plus chaud, ou si un vent qui n’est pas bon souffle, ces défauts ont coutume d’être corrigés par le savoir et la dépense du maître, parce qu’il importe énormément où les fermes ont été situées, quelle taille elles ont, et de quel côté regardent leurs portiques, portes et fenêtres.
# text_fi = Sillä jos maan tai veden läheisyydessä olevan hajun vuoksi, jonka se jossakin paikassa purkaa, tila muuttuu epäterveellisemmäksi, tai taivaan alueen vuoksi maa muuttuu kuumemmaksi, tai ei-hyvä tuuli puhaltaa, nämä viat yleensä korjataan isännän taidolla ja kulutuksella, koska on hyvin tärkeää, mihin huvilat on sijoitettu, kuinka suuria ne ovat ja mihin suuntaan niiden pylväskäytävät, ovet ja ikkunat ovat päin.
# review_status = silver
# elevated_from = bronze
