# sent_id = S000032
# speaker = Narrator
# edition_loc = 1.1.10
# text_old = Hosce ipsos utiliter ad VI libros redegit Diophanes in Bithynia et misit Deiotaro regi.
# text = hosce ipsos utiliter ad VI libros redegit Diophanes in Bithynia et misit Deiotaro regi.
