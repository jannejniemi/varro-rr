# text_old = Illud non dicis, inquit Agrius, quod scribit, "si velis in convivio multum bibere cenareque libenter, ante esse oportet brassicam crudam ex aceto aliqua folia quinque".
# text = illud non dicis – inquit Agrius – quod scribit, “si velis in convivio multum bibere cenareque libenter, ante esse oportet brassicam crudam ex aceto aliqua folia quinque”.
# text_en = "'What you do not mention,' said Agrius, 'is what he writes: “If you wish to drink a great deal at a banquet and dine agreeably, you ought first to eat raw cabbage in vinegar, about five leaves.”'"
# text_fr = « Ce que tu ne dis pas, dit Agrius, c’est ce qu’il écrit : « Si tu veux boire beaucoup dans un banquet et dîner avec plaisir, il faut d’abord manger du chou cru au vinaigre, environ cinq feuilles. » »
# text_fi = "'Se, mitä et mainitse', Agrius sanoi, 'on se, mitä hän kirjoittaa: “Jos haluat juoda paljon pidoissa ja aterioida mielihyvin, sinun tulee ensin syödä raakaa kaalia etikassa, noin viisi lehteä.”'"
