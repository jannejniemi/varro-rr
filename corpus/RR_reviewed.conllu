# sent_id = S000092
# speaker = Fundanius
# edition_loc = 1.2.15
# text_old = Certe, inquit Fundanius, aliut pastio et aliut agri cultura, sed adfinis et ut dextra tibia alia quam sinistra, ita ut tamen sit quodam modo coniuncta, quod est altera eiusdem carminis modorum incentiva, altera succentiva.
# text = certe – inquit Fundanius – aliut pastio et aliut agri cultura, sed adfinis et ut dextra tibia alia quam sinistra, ita ut tamen sit quodam modo coniuncta, quod est altera eiusdem carminis modorum incentiva, altera succentiva.
# text_en = "Certainly," said Fundanius, "husbandry is one thing and agriculture another, but they are related – just as the right pipe is different from the left, so nevertheless it is joined with it in some way, because one is the leading part of the same tune and the other the accompanying part."
# text_fr = « Certes, dit Fundanius, l'élevage est une chose et l'agriculture en est une autre, mais elles sont apparentées – de même que le tuyau droit diffère du gauche, ainsi néanmoins il lui est joint d'une certaine façon, car l'un est la partie mélodique et l'autre la partie d'accompagnement du même air. »
# text_fi = "Varmasti", sanoi Fundanius, "karjanhoito on yksi asia ja maanviljelys toinen, mutta ne ovat sukua toisilleen – niin kuin oikea piippu eroaa vasemmasta, niin se kuitenkin on jollain tavoin siihen yhdistetty, koska toinen on saman sävelmän johtava ääni ja toinen sitä säestävä."
