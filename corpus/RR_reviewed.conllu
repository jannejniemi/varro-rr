# edition_loc = 1.2.3
# text_old = Cum consedissemus, Agrasius, Vos, qui multas perambulastis terras, ecquam cultiorem Italia vidistis? inquit.
# text = cum consedissemus, Agrasius: vos, qui multas perambulastis terras, ecquam cultiorem Italia vidistis? inquit.
# text_en = When we had sat down, Agrasius said: “You, who have traveled through many lands, have you seen any more cultivated than Italy?”
# text_fr = Lorsque nous nous fûmes assis, Agrasius dit : « Vous qui avez parcouru de nombreux pays, en avez-vous vu un plus cultivé que l’Italie ? »
# text_fi = Kun olimme istuutuneet, Agrasius sanoi: ”Te, jotka olette kulkeneet monien maiden halki, oletteko nähneet yhtäkään Italiaa viljellympää?”
