# sent_id = S000096
# speaker = Agrius
# edition_loc = 1.2.17
# text_old = Agrius, Tu, inquit, tibicen non solum adimis domino pecus, sed etiam servis peculium, quibus domini dant ut pascant, atque etiam leges colonicas tollis, in quibus scribimus, colonus in agro surculario ne capra natum pascat;
# text = Agrius: tu – inquit – tibicen non solum adimis domino pecus, sed etiam servis peculium, quibus domini dant ut pascant, atque etiam leges colonicas tollis, in quibus scribimus, colonus in agro surculario ne capra natum pascat;
# text_en = Agrius said: "You, piper, not only take away the master's flock, but also the slaves' savings, which the masters give them so that they may raise [stock with it]; and you also abolish the tenant-farming laws, in which we write: 'let the tenant not pasture a goat-kid in a vineyard';
# text_fr = Agrius dit : « Toi, joueur de flûte, tu enlèves non seulement au maître son troupeau, mais aussi aux esclaves leur pécule, que les maîtres leur donnent pour qu'ils l'élèvent ; et tu abolis aussi les lois du colonat, où nous écrivons : « que le colon ne fasse pas paître de chevreau dans un champ de vignes » ;
# text_fi = Agrius sanoi: "Sinä, huilunsoittaja, et ainoastaan riistä isännältä hänen karjaansa, vaan myös orjilta heidän omaisuuttaan, jonka isännät antavat heille kasvatettavaksi; ja sinä kumoat myös maanviljelyslait, joihin kirjoitamme: 'älköön vuokraviljelijä laiduntako vuohenpoikaa köynnöstarhassa';
# review_status = silver
