# sent_id = S000074
# speaker = Fundanius
# edition_loc = 1.2.10
# text_old = Alterum collegam tuum, viginti virum qui fuit ad agros dividendos Campanos, video huc venire, Cn. Tremelium Scrofam, virum omnibus virtutibus politum, qui de agri cultura Romanus peritissimus existimatur.
# text = alterum collegam tuum, viginti virum qui fuit ad agros dividendos Campanos, video huc venire, Cn. Tremelium Scrofam, virum omnibus virtutibus politum, qui de agri cultura Romanus peritissimus existimatur.
# text_en = I see the other, your colleague, one of the Twenty Men who was assigned to divide the Campanian lands, coming here - Gnaeus Tremelius Scrofa, a man accomplished in every virtue, who is reckoned the most expert Roman in agriculture.
# text_fr = Je vois venir ici l’autre, ton collègue, l’un des Vingt hommes qui fut chargé de diviser les terres campaniennes - Gnaeus Tremelius Scrofa, un homme accompli en toutes les vertus, qui est considéré comme le Romain le plus expert en agriculture.
# text_fi = Näen tänne tulevan sen toisen, virkatoverisi, yhden niistä kahdestakymmenestä miehestä, joka oli määrätty jakamaan Campanian maita - Gnaeus Tremelius Scrofan, kaikin hyvein varustetun miehen, jota pidetään maanviljelyksen taitavimpana roomalaisena.
# review_status = silver
