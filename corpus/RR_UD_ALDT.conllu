# sent_id = S000069
# speaker = Fundanius
# edition_loc = 1.2.8
# text_old = Nemo enim sanus debet velle impensam ac sumptum facere in cultura, si videt non posse refici, nec si potest reficere fructus, si videt eos fore ut pestilentia dispereant.
# text = nemo enim sanus debet velle impensam ac sumptum facere in cultura, si videt non posse refici, nec si potest reficere fructus, si videt eos fore ut pestilentia dispereant.
# text_en = For no sane person ought to want to spend outlay and expense on cultivation, if he sees that it cannot be recovered - nor even if he can recover the produce, if he sees that unhealthy conditions will destroy them.
# text_fr = Car aucun homme sensé ne doit vouloir faire des frais et des dépenses pour la culture, s’il voit qu’ils ne peuvent être récupérés ; ni même s’il peut récupérer les récoltes, s’il voit que des conditions malsaines vont les faire périr.
# text_fi = Kenenkään järkevän ei pidä haluta panna kuluja ja menoja viljelyyn, jos näkee, ettei niitä voida saada takaisin, eikä myöskään, vaikka voisikin saada satoa, jos näkee sen tulevan huonojen olosuhteiden tuhoamaksi.
# review_status = silver
